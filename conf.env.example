# ==============================================================================
#  PVE Ubuntu Server 模板 —— 全局配置
#  改完这个文件，build-template.sh 重建模板时生效；
#  new-vm.sh 每次建机也会读这里的默认值。
# ==============================================================================

# ---------- 模板本身 ----------
TPL_VMID=9000
TPL_NAME=tpl-ubuntu-2404

# Ubuntu 官方 cloud image（qcow2）。
#
# 必须钉死"带日期的版本目录"，不能用 noble/current/ —— 那是滚动路径，
# Ubuntu 一发新的 point release 就换内容，同一份脚本在不同时间跑出来的镜像不一样。
# 20260911 这份实测就是 24.04.5，sha256 与本机现用镜像字节一致。
CLOUD_IMG=/var/lib/vz/template/iso/ubuntu-24.04-cloudimg-amd64.img
CLOUD_IMG_URL=https://cloud-images.ubuntu.com/noble/20260911/noble-server-cloudimg-amd64.img
CLOUD_IMG_SHA256=612b2c0cc1bc413a6cb8c38fd611794caf0f2b436c50013d8b3794db12ad7354

# VM 磁盘存放位置。必须是支持 raw 的存储（本机 local-lvm 是 lvm-thin，只支持 raw）
STORAGE=local-lvm

# 模板里固化的默认规格 —— 新建 VM 时 GUI/脚本的默认值
DISK_SIZE=100G
CORES=4
MEMORY_MB=20480

# 构建【模板】这一台机器时实际分配的内存。
# 模板平时不运行，只有构建那一刻在跑（装包最多用到 2-3G），
# 所以没必要按 MEMORY_MB 分配 —— 内存小的机器也能构建大规格的模板。
# 留空 = 自动取 min(MEMORY_MB, 宿主可用内存的一半, 4096)，最少 2048。
# 构建结束后脚本会把配置里的 memory 改回 MEMORY_MB，clone 出来的 VM 不受影响。
BUILD_MEM_MB=

# new-vm.sh 拒绝低于这个值的 --mem。
# 实测: 2048M 的 clone 启动阶段被 OOM killer 干掉（sd-gens 被杀，boot 完不成）。
# 这套模板装了 766 个包，systemd generator 阶段内存压力不小。4096M 正常。
MIN_MEM_MB=4096

# 内存气球下限（占内存的百分比）。
#
# ⚠️ 坑: `qm set --balloon N` 里的 N 是【最小内存 MiB】，不是 CLI 帮助里写的
#    "target RAM"。源码 QemuServer.pm:2538 -> balloon_min = balloon * 1024*1024。
#    也就是说 PVE 的自动气球可以把这台 VM 压到 N MiB。写 1 等于允许压到 1 MiB。
#    不设这个键的话 balloon_min 视作 0，更糟。
#    这里设成内存的 25% 作为地板。
BALLOON_FLOOR_PCT=25

# 节点级设置：PVE 自动气球的目标内存占用百分比。
#
# pvestatd 的算法（pvestatd.pm:296-320）:
#     goal = memtotal * ballooning-target / 100 - memused
#   goal > 0  ->  宿主有富余，把内存【送给】VM，直到各自 maxmem
#   goal < 0  ->  宿主被 VM 占太多，从 VM【收回】内存，每轮 100MB 逐步逼近 balloon 地板
#
# PVE 默认 80。这台宿主 31G、平时只用 15% 左右，goal 恒为很大的正数 ——
# 听起来应该给内存，但等 VM 真的吃满，memused 会上到 80% 以上，goal 转负，
# PVE 就开始一轮轮往回收，把每台 VM 压到 balloon 地板。
# 实测: 配 4096M 的 VM 被压到 948M，配 2048M 的直接在启动阶段 OOM。
#
# 设成 100 = 目标"宿主永远用满" -> goal 恒为正 -> 每台 VM 稳定在 maxmem，
# 也就是你配的 memory 值。这是可预测的做法。
#
# ⚠️ 代价: 内存不再自动回收。所有 VM 的 memory 之和必须 <= 宿主物理内存，
#    否则宿主会吃 swap 甚至 OOM。这台机 31G，按 20G 一台最多同时跑 1 台大的。
#
# ⚠️ 改完必须重启 pvestatd 才生效（它会缓存节点配置）:
#     systemctl restart pvestatd
#    之后 VM 内存每轮 100MB 往回涨，要 2-4 分钟才到满，属正常。
#
# 改回 PVE 默认: pvenode config set --ballooning-target 80 && systemctl restart pvestatd
AUTO_BALLOON_TARGET=100

# CPU 模型。host = 直接透传宿主 CPU（这台机最快）。
# 想让模板在别的/未来的节点上也能跑，换成 x86-64-v2-AES（Sandy Bridge 之后的
# 通用指令集，含 AES-NI；你这颗 i5-8500T 完全支持，性能差距 1-3%）。
CPU=host

# ---------- 网络 ----------
BRIDGE=vmbr0
NET_MODEL=virtio

# AUTO_DERIVE 里列出的键，bootstrap.sh 会按本机实际情况【自动推导】并回写本文件。
# 换机器时这几个不用手改。想把某个值钉死，就把它从下面这行里删掉。
#
# 推导规则:
#   GATEWAY       网桥同网段的默认网关；取不到则用该网段第一个地址
#   DNS           resolv.conf 里第一个非 CGNAT 的 IPv4 nameserver；取不到用 GATEWAY
#                 ⚠️ 必须跳过 100.64.0.0/10 —— 宿主装了 Tailscale 时 resolv.conf 里
#                    是 100.100.100.100(MagicDNS)，而 guest 没装 Tailscale 根本访问不到，
#                    下发下去等于完全没有 DNS
#   SEARCH_DOMAIN resolv.conf 的 search 域，跳过 *.ts.net（同样是 Tailscale 的）
#   IP_POOL       网桥网段的可用地址，跳过前后各 10 个，最多取 100 个
#                 new-vm.sh --auto-ip 从这里挑空闲地址
#   BUILD_IP      IP_POOL 的第一个，仅构建模板时临时用
AUTO_DERIVE="GATEWAY DNS SEARCH_DOMAIN IP_POOL BUILD_IP"

GATEWAY=192.168.0.1
DNS=192.168.0.1
SEARCH_DOMAIN=randommaker.local
IP_POOL=192.168.0.11-192.168.0.110
BUILD_IP=192.168.0.11

# ---------- 登录 ----------
CI_USER=ubuntu
# 固定密码。clone 出来的每台 VM 都是这个密码（也可以建机时用 --password 覆盖）
CI_PASSWORD='<改成你自己的密码>'

# 烘进模板的 SSH 公钥。模板和它的所有 clone 都能免密登录
SSH_PUBKEY_FILE='<你的 SSH 公钥路径>'
# 构建 / 建机时用的私钥（要和上面的公钥配对）
SSH_KEY_FILE='<你的 SSH 私钥路径>'

# ---------- guest 内部定制 ----------
TIMEZONE=Asia/Shanghai

# swap 文件大小，0 = 不建。模板里保持 0 最干净（磁盘 grow 时不会踩坑），
# 需要的话改成 2G 之类，重建模板生效。
SWAP_SIZE=0

# 预装软件包。Dev / 开发测试向：编译工具链 + 常用命令行工具，不装任何语言运行时
#（node/java/go/python 用容器跑更合适）。空着则用下面的 PKG_EXTRA 追加。
PKG_CORE="
  qemu-guest-agent
  cloud-guest-utils
  cloud-init
  build-essential
  pkg-config
  gdb
  git
  git-lfs
  curl
  wget
  rsync
  ca-certificates
  gnupg
  openssh-client
  openssh-server
  vim
  tmux
  htop
  tree
  jq
  ripgrep
  less
  unzip
  zip
  xz-utils
  p7zip-full
  silversearcher-ag
  bash-completion
  locales
  tzdata
  iproute2
  iputils-ping
  dnsutils
  netcat-openbsd
  socat
  lsof
  procps
  psmisc
  file
  strace
  nmap
  python3-pip
  python3-venv
  python3-dev
  shellcheck
  smartmontools
  nvme-cli
  usbutils
  pciutils
  lm-sensors
  apparmor-utils
  auditd
"

# 额外想装的包，追加在这里（空格分隔）
PKG_EXTRA=""

# ---------- 构建行为 ----------
BUILD_LOG=/var/log/pve-template-build.log
# 1 = 保留构建机里的 cloud-init 状态和 SSH host key（调试用，不要用于生产模板）
KEEP_CLEAN=0
